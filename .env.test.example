# Credentials for the Playwright E2E smoke test.
# Copy to .env.test and fill in. The values must correspond to a real user
# created in the WorkOS dashboard for the dev environment.
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=replace-me

# Optional. Defaults to http://localhost:3000. Override to point at a deployed
# preview, but only if that deployment uses the same WorkOS dev environment.
# E2E_BASE_URL=http://localhost:3000

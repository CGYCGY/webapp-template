# Convex
# Run `npx convex dev` to get your deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS — https://dashboard.workos.com
WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXX
# Must match the Redirect URI set in WorkOS dashboard → Authentication
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_API_KEY=sk_live_01XXXXXXXXXXXXXXXXXX
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=a-32-character-or-longer-secret-key-here
# From WorkOS dashboard → Webhooks → Endpoint signing secret (create endpoint
# at https://[deployment].convex.site/workos/webhook first)
WORKOS_WEBHOOK_SECRET=wsec_XXXXXXXXXXXXXXXXXX
# From WorkOS dashboard → Actions → Endpoint signing secret (create endpoint
# at https://[deployment].convex.site/workos/action first). Required by the
# AuthKit component even if no action handlers are registered — set to any
# non-empty placeholder until you wire up real WorkOS Actions.
WORKOS_ACTION_SECRET=disabled

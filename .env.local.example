# Convex
# Run `npx convex dev` to get your deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS — https://dashboard.workos.com
WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXX
# Must match the Redirect URI set in WorkOS dashboard → Authentication
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_API_KEY=sk_live_01XXXXXXXXXXXXXXXXXX
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=a-32-character-or-longer-secret-key-here
# From WorkOS dashboard → Webhooks → Endpoint signing secret (create endpoint
# at https://[deployment].convex.site/workos/webhook first)
WORKOS_WEBHOOK_SECRET=wsec_XXXXXXXXXXXXXXXXXX
# From WorkOS dashboard → Actions → Endpoint signing secret (create endpoint
# at https://[deployment].convex.site/workos/action first). Required by the
# AuthKit component even if no action handlers are registered — set to any
# non-empty placeholder until you wire up real WorkOS Actions.
WORKOS_ACTION_SECRET=disabled

# PostHog product analytics — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://XXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_DSN=https://XXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_AUTH_TOKEN=sntrys_XXXXXXXXXXXXXXXX
SENTRY_ORG=your-org
SENTRY_PROJECT=webapp-template

# ---------------------------------------------------------------------------
# Convex-only env vars (set via `npx convex env set KEY VALUE`).
# Documented here so a fresh checkout has a single place to find every secret.
# ---------------------------------------------------------------------------

# Cloudflare R2 — used by Convex actions to issue presigned upload URLs
R2_ACCOUNT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
R2_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
R2_BUCKET=your-bucket-name
R2_PUBLIC_BASE_URL=https://cdn.example.com

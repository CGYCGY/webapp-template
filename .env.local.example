# Convex
# Run `npx convex dev` to get your deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS — https://dashboard.workos.com
WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXX
WORKOS_API_KEY=sk_live_01XXXXXXXXXXXXXXXXXX
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=a-32-character-or-longer-secret-key-here

# WorkOS Webhook (set via Convex CLI, not .env.local):
#   npx convex env set WORKOS_CLIENT_ID=...
#   npx convex env set WORKOS_API_KEY=...
#   npx convex env set WORKOS_WEBHOOK_SECRET=...  (from WorkOS dashboard after creating webhook)
